# ============================================================================
# VerifAI – environment configuration (copy to .env; never commit .env)
# All values are for a LOCAL DEMO. Nothing here touches real systems.
# ============================================================================

# --- Application -------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api

# --- Security ----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-development-only-secret-key-0123456789
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false                # true when served over HTTPS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo login (the only account). Change for your own deployment.
DEMO_USERNAME=demo.analyst
DEMO_PASSWORD=demo-pass-2024
DEMO_DISPLAY_NAME=Demo Analyst
DEMO_ROLE=reviewer

RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_ASSISTANT=30/minute

# --- Database ----------------------------------------------------------------
# Local dev without Docker: SQLite (default). With docker-compose: PostgreSQL.
# DATABASE_URL=sqlite:///./backend/data/verifai.db
DATABASE_URL=postgresql+psycopg://verifai:verifai@localhost:5432/verifai
POSTGRES_USER=verifai
POSTGRES_PASSWORD=verifai
POSTGRES_DB=verifai

# --- Document pipeline -------------------------------------------------------
MAX_UPLOAD_BYTES=5242880           # 5 MB
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/json

# --- Human-in-the-loop thresholds (0-100) ------------------------------------
AUTO_VERIFY_MIN_CONFIDENCE=90      # >= this => auto verified
REVIEW_MIN_CONFIDENCE=70           # [REVIEW_MIN, AUTO_VERIFY_MIN) => human review; below => rejection path

# --- LLM via Ollama (runs on the host) ---------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6
OLLAMA_TIMEOUT_SECONDS=120
LLM_ENABLED=true
LLM_TEMPERATURE=0.1

# --- RAG ---------------------------------------------------------------------
# Leave QDRANT_URL empty to use the embedded local Qdrant store (no server needed).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kyc_policies
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=5
RAG_MIN_SCORE=0.35

# --- Frontend (Vite) ---------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_USE_MOCKS=false
