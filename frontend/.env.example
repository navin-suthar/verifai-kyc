# Frontend configuration. Only non-secret values belong here: everything
# prefixed with VITE_ is embedded in the browser bundle.

# Base path of the backend API. The Vite dev server proxies /api to the backend.
VITE_API_BASE_URL=/api

# Backend origin used by the Vite dev-server proxy (not exposed to the browser).
VITE_PROXY_TARGET=http://localhost:8000

# Serve synthetic in-memory data instead of calling the API (Phase 1 / UI demos).
VITE_USE_MOCKS=false

VITE_APP_NAME=VerifAI
VITE_REQUEST_TIMEOUT_MS=30000
